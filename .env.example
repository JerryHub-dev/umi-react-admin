# Cesium Ion Token
# 从 https://ion.cesium.com/ 获取你的 token
# CESIUM_ION_TOKEN=

# 只为演示明确启用；真实接入时删除或设置 false。
UMI_APP_DEMO_MODE=true
# 真实后端使用同源路径，由部署入口代理到后端；不可填跨源 URL。
# UMI_APP_API_BASE=/


# 可选：高德 Web 端（JS API）Key 与安全密钥（https://console.amap.com 申请）。
# 不配置时不加载地图 SDK；正式部署请配置受来源/配额限制的公开 Web Key。
# AMAP_KEY=
# AMAP_SECURITY_CODE=

# 模板不加载统计/会话回放。另行接入时先处理同意、脱敏与 CSP，不可直接注入 CLARITY_ID。
