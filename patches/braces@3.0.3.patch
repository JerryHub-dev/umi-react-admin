--- /dev/null
+++ b/lib/security.js
@@ -0,0 +1,110 @@
+'use strict';
+
+// GHSA-vfj7-8cjw-p6xm: bound recursive entry points and result allocation.
+// These hard ceilings cannot be disabled with rangeLimit/maxLength options.
+const MAX_DEPTH = 64;
+const MAX_NODES = 65536;
+const MAX_RESULTS = 1000;
+const MAX_BYTES = 1024 * 1024;
+const MAX_WORK_BYTES = 4 * MAX_BYTES;
+
+const fail = reason => { throw new RangeError(`braces resource limit exceeded: ${reason}`); };
+const bytes = value => Buffer.byteLength(String(value), 'utf8');
+const checkString = value => {
+  if (bytes(value) > MAX_BYTES) fail('output bytes');
+  return value;
+};
+
+const validateAST = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const seen = new Set();
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (!node || typeof node !== 'object') throw new TypeError('Expected an AST node');
+    if (seen.has(node)) fail('cyclic or shared AST');
+    seen.add(node);
+    if (seen.size > MAX_NODES) fail('AST nodes');
+    if (depth > MAX_DEPTH + 1 || (node.nodes && depth > MAX_DEPTH)) fail('AST depth');
+    if (node.value !== undefined) {
+      if (typeof node.value !== 'string') throw new TypeError('Expected a string AST value');
+      checkString(node.value);
+    }
+    // Parent/prev references intentionally exist in parser ASTs. Only nodes
+    // are children; parent chains must also be finite before expansion.
+    const ancestors = new Set();
+    let parent = node.parent;
+    while (parent) {
+      if (typeof parent !== 'object' || ancestors.has(parent) || parent === node) fail('cyclic AST parent');
+      ancestors.add(parent);
+      if (ancestors.size > MAX_DEPTH + 1) fail('AST parent depth');
+      parent = parent.parent;
+    }
+    if (node.nodes !== undefined) {
+      if (!Array.isArray(node.nodes)) throw new TypeError('Expected an AST nodes array');
+      if (node.nodes.length + seen.size + pending.length > MAX_NODES) fail('AST nodes');
+      for (let index = node.nodes.length - 1; index >= 0; index--) {
+        pending.push({ node: node.nodes[index], depth: depth + 1 });
+      }
+    }
+  }
+};
+
+const flatten = (...args) => {
+  const result = [];
+  const frames = [{ values: args, index: 0 }];
+  const active = new Set([args]);
+  let outputBytes = 0;
+  while (frames.length) {
+    const frame = frames[frames.length - 1];
+    if (frame.index === frame.values.length) {
+      active.delete(frame.values);
+      frames.pop();
+      continue;
+    }
+    const value = frame.values[frame.index++];
+    if (Array.isArray(value)) {
+      if (active.has(value)) fail('cyclic expansion');
+      if (frames.length > MAX_DEPTH + 1) fail('expansion depth');
+      active.add(value);
+      frames.push({ values: value, index: 0 });
+    } else if (value !== undefined) {
+      if (result.length >= MAX_RESULTS) fail('expanded paths');
+      outputBytes += bytes(value);
+      if (outputBytes > MAX_BYTES) fail('output bytes');
+      result.push(value);
+    }
+  }
+  return result;
+};
+
+const checkRange = (args, options = {}) => {
+  const [start, end] = args;
+  const numeric = value => value !== '' && Number.isInteger(Number(value));
+  let min, max;
+  if (numeric(start) && numeric(end)) {
+    min = Number(start); max = Number(end);
+    if (!Number.isSafeInteger(min) || !Number.isSafeInteger(max)) fail('range endpoints');
+  } else if (typeof start === 'string' && typeof end === 'string' && start.length === 1 && end.length === 1) {
+    min = start.charCodeAt(0); max = end.charCodeAt(0);
+  } else {
+    return;
+  }
+  const rawStep = args[2] === undefined ? options.step : args[2];
+  const step = Math.abs(Number(rawStep || 1));
+  if (!Number.isSafeInteger(step) || step < 1) fail('range step');
+  const limit = typeof options.rangeLimit === 'number' && Number.isFinite(options.rangeLimit)
+    ? Math.min(MAX_RESULTS, Math.max(0, options.rangeLimit)) : MAX_RESULTS;
+  if (Math.floor(Math.abs(max - min) / step) + 1 > limit) fail('range length');
+};
+
+const budget = () => {
+  let workBytes = 0;
+  let workItems = 0;
+  return size => {
+    if (size > MAX_BYTES) fail('output bytes');
+    workBytes += size; workItems++;
+    if (workBytes > MAX_WORK_BYTES || workItems > MAX_NODES) fail('expansion work');
+  };
+};
+
+module.exports = { MAX_DEPTH, MAX_NODES, MAX_RESULTS, MAX_BYTES, fail, bytes, checkString, validateAST, flatten, checkRange, budget };
